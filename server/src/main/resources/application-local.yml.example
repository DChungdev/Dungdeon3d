spring:
  application:
    name: dungeon-delvers-server

  datasource:
    url: jdbc:postgresql://localhost:5432/dungeon_delvers
    username: postgre
    password: 123456
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2

  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        jdbc:
          time_zone: UTC

  flyway:
    enabled: true
    locations: classpath:db/migration

  data:
    redis:
      host: localhost
      port: 6379

server:
  port: 8080

ddo:
  jwt:
    secret: dev-secret-change-in-production-min-32-chars!!
    access-token-ttl-sec: 900
    refresh-token-ttl-sec: 604800
  cors:
    allowed-origins: "*"
  game:
    hub-max-players-per-shard: 30
    instance-max-players: 4
    instance-idle-timeout-sec: 300
    combat-tick-hz: 10
    reconnect-grace-sec: 60

logging:
  level:
    root: INFO
    com.dungeondelvers: DEBUG

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
